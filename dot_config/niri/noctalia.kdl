layout {

    focus-ring {
        active-color   "#c4cd6e"
        inactive-color "#13140d"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#c4cd6e"
        inactive-color "#13140d"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#c4cd6e"
        inactive-color "#6f7721"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#c4cd6e80"
    }
}

recent-windows {
    highlight {
        active-color "#c4cd6e"
        urgent-color "#ffb4ab"
    }
}
