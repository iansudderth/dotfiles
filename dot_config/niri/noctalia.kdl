layout {

    focus-ring {
        active-color   "#67abe4"
        inactive-color "#12202c"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#67abe4"
        inactive-color "#12202c"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#67abe4"
        inactive-color "#145185"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#67abe480"
    }
}

recent-windows {
    highlight {
        active-color "#67abe4"
        urgent-color "#fd4663"
    }
}
