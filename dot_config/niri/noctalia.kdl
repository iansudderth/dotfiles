layout {

    focus-ring {
        active-color   "#c4b28a"
        inactive-color "#1f1f28"
        urgent-color   "#c4746e"
    }

    border {
        active-color   "#c4b28a"
        inactive-color "#1f1f28"
        urgent-color   "#c4746e"
    }


    tab-indicator {
        active-color   "#c4b28a"
        inactive-color "#6f5a2c"
        urgent-color   "#c4746e"
    }

    insert-hint {
        color "#c4b28a80"
    }
}

recent-windows {
    highlight {
        active-color "#c4b28a"
        urgent-color "#c4746e"
    }
}
